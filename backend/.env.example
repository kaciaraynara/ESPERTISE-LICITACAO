# ==========================================
# EXPERTISE LICITATÓRIA — BACKEND ENV EXAMPLE
# ==========================================

# Ambiente e Servidor
NODE_ENV=development
PORT=3001
FRONTEND_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"
ENABLE_LEX=false
ENABLE_BID_ROBOT=false
ENABLE_CRM=false

# Banco de Dados (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Filas resilientes (BullMQ / Redis) — obrigatório no processo backend worker
REDIS_URL="redis://localhost:6379"
CONTRACT_MONITOR_CRON="0 8 * * *"

# Autenticação e Segurança
JWT_SECRET="sua_chave_jwt_secreta_com_mais_de_32_caracteres_hex"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ==========================================
# MERCADO PAGO (ASSINATURAS E WEBHOOK)
# ==========================================
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
MP_PLAN_BASIC=""
MP_PLAN_PRO=""
MP_PLAN_MASTER=""
MP_BACK_URL="http://localhost:5173/fornecedor/planos"

# ==========================================
# INTEGRAÇÕES GOVERNAMENTAIS (DADOS ABERTOS OFICIAIS)
# ==========================================
PNCP_BASE_URL="https://pncp.gov.br/api/consulta/v1"
PNCP_FILES_BASE_URL="https://pncp.gov.br/api/pncp/v1"
PNCP_INGEST_MAX_PAGES=20
PNCP_TIMEOUT=20000
# Sincronização diária do PNCP: executar no processo worker (npm run dev:worker).
CRON_JOBS_ENABLED=true
ENABLE_CRON_JOBS=true
PNCP_CRON_SCHEDULE="0 2,14 * * *"
PNCP_MAX_PAGES_PER_RUN=50
PNCP_PAGE_DELAY_MS=400
COMPRASGOV_BASE_URL="https://dadosabertos.compras.gov.br"
COMPRASGOV_TIMEOUT=20000
BRASILAPI_URL="https://brasilapi.com.br"
INFOSIMPLES_TOKEN=""
INFOSIMPLES_API_BASE_URL="https://api.infosimples.com/api/v2/consultas"
INFOSIMPLES_TIMEOUT_MS=30000
PORTAL_TRANSPARENCIA_BASE_URL="https://api.portaldatransparencia.gov.br/api-de-dados"
PORTAL_TRANSPARENCIA_TIMEOUT=15000
PORTAL_TRANSPARENCIA_TOKEN=""
WHATSAPP_API_URL=""
WHATSAPP_CLIENT_TOKEN=""

# ==========================================
# INTELIGÊNCIA ARTIFICIAL (GOOGLE GEMINI)
# ==========================================
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-3.8-flash"
DEFAULT_AI_PROVIDER="gemini"

# Notificações e Emails
RESEND_API_KEY="re_..."
EMAIL_FROM="onboarding@resend.dev"

# ==========================================
# STORAGE DE ARQUIVOS (CLOUDFLARE R2 / S3-COMPATIBLE)
# ==========================================
S3_ENDPOINT_URL="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
AWS_REGION="auto"
AWS_ACCESS_KEY_ID="<R2_ACCESS_KEY_ID>"
AWS_SECRET_ACCESS_KEY="<R2_SECRET_ACCESS_KEY>"
AWS_S3_BUCKET="expertise-licitatoria-storage"
