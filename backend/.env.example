# ============================================================
# EXPERTISE Backend - variaveis de ambiente
# Copie para .env e preencha segredos reais fora do git.
# ============================================================

NODE_ENV=development
PORT=3001
LOG_LEVEL=info
LOG_FILE=logs/expertise.log

# Banco principal PostgreSQL/Supabase Postgres (obrigatório)
DATABASE_URL=

ENABLE_BID_ROBOT=false
ENABLE_LEX=false
ENABLE_CRM=false
# Módulos legados incompletos: proibidos em produção.
ENABLE_LEGACY_MARKETPLACE=false
ENABLE_LEGACY_PRICING_STRATEGY=false
# Bootstrap administrativo por allowlist de ambiente: somente para testes locais controlados.
RBAC_ALLOW_ENV_FALLBACK=false

# JWT e cookies
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_DOMAIN=

# CORS - informe apenas origens reais separadas por vírgula
CORS_ORIGIN=

# Mercado Pago - nenhuma assinatura e ativada sem IDs reais
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_BACK_URL=
MP_PLAN_BASIC=
MP_PLAN_PRO=
MP_PLAN_MASTER=

# PNCP e Compras.gov
PNCP_URL=https://pncp.gov.br/api/pncp/v1
PNCP_BASE_URL=https://pncp.gov.br/api/consulta/v1
PNCP_CONSULTA_BASE_URL=https://pncp.gov.br/api/consulta/v1
PNCP_TIMEOUT=30000
PNCP_RETRIES=2
PNCP_DOSSIE_TIMEOUT=20000
PNCP_DOSSIE_PAGE_SIZE=50
PNCP_DOSSIE_MAX_PAGES=5
CONCORRENTES_DOSSIE_YEARS_BACK=5
CONCORRENTES_DOSSIE_MAX_ITEMS=100
TRANSPARENCIA_DOSSIE_MAX_PAGES=3
COMPRASGOV_BASE_URL=https://compras.dados.gov.br
COMPRASGOV_LICITACOES_PATH=/licitacoes/v1/licitacoes.json
COMPRASGOV_TIMEOUT=30000
CND_RENEWAL_CRON=0 0 * * *
CRON_TZ=America/Sao_Paulo

# IA
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
GROK_API_KEY=
GROK_MODEL=grok-2-latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# CNPJ
BRASILAPI_URL=https://brasilapi.com.br

# BANCO NEON
DATABASE_URL=
DIRECT_URL=


# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
USER_RATE_LIMIT_WINDOW_MS=900000
USER_RATE_LIMIT_MAX=300

# LGPD
CRON_JOBS_ENABLED=false
DATA_PLATFORM_WORKERS_ENABLED=false
PRIVACY_CRON=0 3 * * *
LGPD_RETENTION_DAYS=30

# WhatsApp opcional
WHATSAPP_API_URL=
WHATSAPP_INSTANCE_ID=
WHATSAPP_TOKEN=

# Portal da Transparência
# Obtenha o token em: https://portaldatransparencia.gov.br/api-de-dados
PORTAL_TRANSPARENCIA_TOKEN=
PORTAL_TRANSPARENCIA_BASE_URL=https://api.portaldatransparencia.gov.br/api-de-dados
PORTAL_TRANSPARENCIA_TIMEOUT=15000
