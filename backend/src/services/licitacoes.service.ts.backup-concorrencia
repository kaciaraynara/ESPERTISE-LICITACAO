// ─── Busca ao vivo ──────────────────────────────────────────────────────────
async function buscarAoVivo(
  filtros: FiltrosBusca, pagina: number, tamanhoPagina: number, empresa?: EmpresaRadarPerfil | null,
): Promise<{ data: LicitacaoRadar[]; total: number; totalPaginas: number; fonte: FonteRadar; aviso?: string }> {
  const [pncpResult, comprasGovResult] = await Promise.allSettled([
    buscarContratacoesPNCP({ ...filtros, pagina: 1, tamanhoPagina: 50 }),
    buscarLicitacoesComprasGov({ descricao: filtros.palavrasChave, uf: filtros.uf, valorMin: filtros.valorMin, valorMax: filtros.valorMax, modalidade: filtros.modalidade, pagina: 1 }),
  ]);
  const pncpItems = pncpResult.status === 'fulfilled' ? pncpResult.value.data.map((i: LicitacaoPNCP) => normalizarDoPncp(i, filtros, empresa)) : [];
  const comprasGovItems = comprasGovResult.status === 'fulfilled' ? comprasGovResult.value.data.map((i: LicitacaoComprasGov) => normalizarDoComprasGov(i, filtros, empresa)) : [];
  if (pncpResult.status === 'fulfilled' && pncpResult.value.data.length > 0) {
    salvarNoBanco(pncpResult.value.data).catch((e) => console.warn('[Prisma] Cache falhou:', e?.message));
  }
  const merged = ordenarRadar(deduplicarRadar([...pncpItems, ...comprasGovItems]));
  if (merged.length === 0) {
    return { data: [], total: 0, totalPaginas: 0, fonte: 'vazio', aviso: 'Nenhum edital encontrado nas fontes oficiais.' };
  }
  let fonte: FonteRadar = 'mista';
  if (pncpItems.length > 0 && comprasGovItems.length === 0) fonte = 'pncp';
  if (comprasGovItems.length > 0 && pncpItems.length === 0) fonte = 'comprasgov';
  const notices: string[] = [];
  if (pncpResult.status === 'rejected') notices.push('PNCP indisponível');
  if (comprasGovResult.status === 'rejected') notices.push('Compras.gov indisponível');
  const from = (pagina - 1) * tamanhoPagina;
  return { data: merged.slice(from, from + tamanhoPagina), total: merged.length, totalPaginas: Math.ceil(merged.length / tamanhoPagina), fonte, aviso: notices.length ? `Resultados parciais — ${notices.join(' · ')}.` : undefined };
}

// ─── Função principal exportada ────────────────────────────────────────────
export async function listarLicitacoes(
  filtros: FiltrosBusca, empresa?: EmpresaRadarPerfil | null,
): Promise<{ data: LicitacaoRadar[]; total: number; totalPaginas: number; fonte: FonteRadar; aviso?: string }> {
  const pagina = filtros.pagina || 1;
  const tamanhoPagina = filtros.tamanhoPagina || 20;

  // 1. Cache PostgreSQL
  const cache = await buscarDoBanco(filtros);
  const cacheNormalizado = cache.data.map((row) => normalizarDoBanco(row, filtros, empresa));
  if (cacheNormalizado.length > 0) {
    const fresco = await cacheEstaFresco();
    if (fresco) {
      console.log('[Licitações] Cache fresco PostgreSQL.');
      return { data: cacheNormalizado, total: cache.total, totalPaginas: Math.ceil(cache.total / tamanhoPagina), fonte: 'cache' };
    }
    buscarAoVivo(filtros, 1, 50, empresa).catch((e) => console.warn('[Bg]', e?.message));
    return { data: cacheNormalizado, total: cache.total, totalPaginas: Math.ceil(cache.total / tamanhoPagina), fonte: 'cache', aviso: 'Cache anterior. Atualizando em segundo plano.' };
  }

  // 2. PNCP ao vivo com timeout
  console.log('[Licitações] Cache vazio — consultando PNCP...');
  try {
    const resultado = await withTimeout(buscarAoVivo(filtros, pagina, tamanhoPagina, empresa), 20000);
    if (resultado.data.length > 0) return resultado;
  } catch (e: any) {
    console.warn('[Licitações] PNCP falhou:', e?.message);
  }

  // 3. Dados de demonstração somente com flag explicita
  if (!isDemoDataEnabled()) {
    return {
      data: [],
      total: 0,
      totalPaginas: 0,
      fonte: 'vazio',
      aviso: 'Nenhum edital encontrado nas fontes oficiais. Dados demo estao desativados.',
    };
  }

  console.warn('[Licitações] Usando dados de demonstração por ENABLE_DEMO_DATA=true.');
  const demo = filtros.uf ? DADOS_DEMO.filter((d) => d.uf === filtros.uf!.toUpperCase()) : DADOS_DEMO;
  const items = demo.length > 0 ? demo : DADOS_DEMO;
  const from = (pagina - 1) * tamanhoPagina;
  return {
    data: items.slice(from, from + tamanhoPagina),
    total: items.length,
    totalPaginas: Math.ceil(items.length / tamanhoPagina),
    fonte: 'vazio',
    aviso: 'PNCP indisponível. Exibindo editais de demonstração porque ENABLE_DEMO_DATA=true.',
  };
}

// ─── Sincronização manual ──────────────────────────────────────────────────
export async function sincronizarCache(palavrasChave?: string, uf?: string): Promise<{ sincronizados: number; erro?: string }> {
  try {
    console.log('[Sincronização] Iniciando varredura PNCP...');
    const resultado = await buscarContratacoesPNCP({ palavrasChave, uf, pagina: 1, tamanhoPagina: 100 });
    await salvarNoBanco(resultado.data);
    return { sincronizados: resultado.data.length };
  } catch (error: any) {
    return { sincronizados: 0, erro: error.message };
  }
}

function withTimeout<T>(promise: Promise<T>, timeoutMs: number): Promise<T> {
  let timeout: NodeJS.Timeout;
  const timeoutPromise = new Promise<never>((_, reject) => {
    timeout = setTimeout(() => reject(new Error('timeout')), timeoutMs);
  });

  return Promise.race([
    promise.finally(() => clearTimeout(timeout)),
    timeoutPromise,
  ]);
}
