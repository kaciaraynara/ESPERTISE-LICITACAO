{
  "name": "expertise-licitatoria-backend",
  "version": "1.0.0",
  "description": "EXPERTISE Licitatória - API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node --transpile-only -r dotenv/config -r tsconfig-paths/register src/server.ts",
    "dev:watch": "nodemon",
    "dev:status": "powershell -ExecutionPolicy Bypass -File .\\scripts\\dev-server.ps1 status",
    "dev:stop": "powershell -ExecutionPolicy Bypass -File .\\scripts\\dev-server.ps1 stop",
    "dev:restart": "powershell -ExecutionPolicy Bypass -File .\\scripts\\dev-server.ps1 restart",
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run start:api",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev:worker": "ts-node --transpile-only -r dotenv/config -r tsconfig-paths/register src/worker.ts",
    "migrate": "prisma migrate deploy",
    "migrate:init": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-initial-migration.ps1",
    "migrate:dev": "prisma migrate dev",
    "prisma": "prisma generate",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "test": "jest --runInBand --coverage",
    "seed:legal-rules": "ts-node --transpile-only -r dotenv/config -r tsconfig-paths/register src/seeds/seed-legal-rules.ts",
    "seed:legal-chunks": "ts-node --transpile-only -r dotenv/config -r tsconfig-paths/register src/seeds/seed-legal-chunks.ts",
    "seed:templates": "ts-node --transpile-only -r dotenv/config -r tsconfig-paths/register src/seeds/seed-document-templates.ts",
    "seed:all": "npm run seed:legal-rules && npm run seed:legal-chunks && npm run seed:templates"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.3",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "bottleneck": "^2.19.5",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "docx": "^9.7.1",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^3.2.0",
    "multer": "^2.2.0",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "openai": "^4.24.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.1",
    "prisma": "^7.9.0",
    "resend": "^6.17.2",
    "sanitize-html": "^2.17.6",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "ws": "^8.21.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "@types/sanitize-html": "^2.9.5",
    "@types/socket.io": "^3.0.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
