model Proposal {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId           String         @map("company_id") @db.Uuid
  procurementNoticeId String?        @map("procurement_notice_id") @db.Uuid
  titulo              String
  status              ProposalStatus @default(RASCUNHO)
  moeda               String         @default("BRL")
  validadeDias        Int?           @map("validade_dias")
  validadeAte         DateTime?      @map("validade_ate") @db.Timestamptz(6)
  prazoEntregaDias    Int?           @map("prazo_entrega_dias")
  condicoesPagamento  String?        @map("condicoes_pagamento") @db.Text
  garantia            String?        @db.Text
  observacoes         String?        @db.Text
  createdById         String         @map("created_by_id") @db.Uuid
  responsibleUserId   String?        @map("responsible_user_id") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company           Company            @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  procurementNotice ProcurementNotice? @relation(fields: [procurementNoticeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy         User               @relation("ProposalCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  responsibleUser   User?              @relation("ProposalResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  items             ProposalItem[]

  deadlines Deadline[]

  @@index([companyId, status])
  @@index([companyId, updatedAt])
  @@index([procurementNoticeId])
  @@index([createdById])
  @@index([responsibleUserId])
  @@map("proposals")
}

model ProposalItem {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proposalId              String   @map("proposal_id") @db.Uuid
  procurementItemId       String?  @map("procurement_item_id") @db.Uuid
  codigo                  String?
  numero                  String?
  descricao               String   @db.Text
  unidade                 String
  quantidade              Decimal  @db.Decimal(18, 4)
  marca                   String?
  modelo                  String?
  custoUnitario           Decimal? @map("custo_unitario") @db.Decimal(18, 4)
  precoUnitarioProposto   Decimal? @map("preco_unitario_proposto") @db.Decimal(18, 4)
  precoTotalProposto      Decimal? @map("preco_total_proposto") @db.Decimal(18, 2)
  margemPercentual        Decimal? @map("margem_percentual") @db.Decimal(5, 2)
  catalogoCodigo          String?  @map("catalogo_codigo")
  catalogoPrecoReferencia Decimal? @map("catalogo_preco_referencia") @db.Decimal(18, 4)
  posicao                 Int
  observacoes             String?  @db.Text
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([proposalId])
  @@index([proposalId, posicao])
  @@index([procurementItemId])
  @@map("proposal_items")
}

