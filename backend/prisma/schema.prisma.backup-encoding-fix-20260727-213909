generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  users     User[]
  companies Company[]

  @@index([active])
  @@map("tenants")
}

model User {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String                  @map("tenant_id") @db.Uuid
  email                String                  @unique
  emailNormalized      String                  @unique @map("email_normalized")
  nome                 String?
  telefone             String?
  plano                String                  @default("free")
  emailVerificado      Boolean                 @default(false) @map("email_verificado")
  ultimoAcesso         DateTime?               @map("ultimo_acesso") @db.Timestamptz(6)
  passwordHash         String                  @map("password_hash")
  aceiteLgpd           Boolean                 @default(false) @map("aceite_lgpd")
  role                 AccountRole             @default(fornecedor)
  oabNumero            String?                 @map("oab_numero")
  oabUf                String?                 @map("oab_uf")
  crcNumero            String?                 @map("crc_numero")
  crcUf                String?                 @map("crc_uf")
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?               @map("deleted_at") @db.Timestamptz(6)
  anonymizedAt         DateTime?               @map("anonymized_at") @db.Timestamptz(6)
  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  companies            Company[]
  documents            Document[]
  lawyerProfile        JuridicoProfile?
  legalCasesClient     JuridicoCase[]          @relation("LegalClient")
  legalCasesLawyer     JuridicoCase[]          @relation("LegalLawyer")
  legalMessages        JuridicoMessage[]
  fornecedoresB2B      FornecedorMarketplace[]
  marketplaceItems     MarketplaceItem[]
  notifications        Notification[]
  rbacRoles            UserRole[]              @relation("RbacUserRoles")
  rbacRolesAssigned    UserRole[]              @relation("RbacAssignedRoles")
  refreshTokens        RefreshToken[]
  subscriptions        Subscription[]
  proposalsCreated     Proposal[]              @relation("ProposalCreator")
  proposalsResponsible Proposal[]              @relation("ProposalResponsible")
  biddingPipelines     BiddingPipeline[]

  monitoredNotices  CompanyMonitoredNotice[]
  assignedDeadlines Deadline[]

  @@index([tenantId])
  @@index([deletedAt, anonymizedAt])
  @@map("users")
}

model ApiRateLimitBucket {
  key       String   @id
  hits      Int      @default(0)
  resetAt   DateTime @map("reset_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([resetAt])
  @@map("api_rate_limit_buckets")
}

model Company {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String               @map("tenant_id") @db.Uuid
  userId               String               @map("user_id") @db.Uuid
  cnpj                 String
  razaoSocial          String               @map("razao_social")
  nomeFantasia         String?              @map("nome_fantasia")
  cnaePrincipal        String?              @map("cnae_principal")
  municipio            String?
  uf                   String?
  status               String?
  nicho                String[]             @default([])
  palavrasChave        String[]             @default([]) @map("palavras_chave")
  valorMin             Decimal?             @map("valor_min") @db.Decimal(14, 2)
  valorMax             Decimal?             @map("valor_max") @db.Decimal(14, 2)
  regioes              String[]             @default([])
  orgaosPreferidos     String[]             @default([]) @map("orgaos_preferidos")
  orgaosBloqueados     String[]             @default([]) @map("orgaos_bloqueados")
  impedimentoLicitacao Boolean              @default(false) @map("impedimento_licitacao")
  impedimentoDetalhes  String?              @map("impedimento_detalhes") @db.Text
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  certificates         CompanyCertificate[]
  documents            Document[]
  proposals            Proposal[]

  moduleAccess     CompanyModuleAccess[]
  monitoredNotices CompanyMonitoredNotice[]
  deadlines        Deadline[]

  @@unique([userId, cnpj])
  @@unique([tenantId, cnpj])
  @@index([tenantId])
  @@index([userId])
  @@index([uf])
  @@map("companies")
}

model RefreshToken {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @map("token_hash")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, tokenHash])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Document {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  companyId    String?        @map("company_id") @db.Uuid
  tipo         String
  nome         String
  validade     DateTime?      @db.Timestamptz(6)
  status       DocumentStatus @default(valido)
  url          String?
  arquivoNome  String?        @map("arquivo_nome")
  criadoEm     DateTime       @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime       @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)
  company      Company?       @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([companyId])
  @@index([validade])
  @@map("documents")
}

model Notification {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  tipo        NotificationType
  titulo      String
  mensagem    String
  canal       String             @default("painel")
  status      NotificationStatus @default(enviada)
  enviadaEm   DateTime?          @map("enviada_em") @db.Timestamptz(6)
  licitacaoId String?            @map("licitacao_id")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  lida        Boolean            @default(false)
  link        String?
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdAt])
  @@index([userId, lida], map: "notifications_user_lida_idx")
  @@map("notifications")
}

model Subscription {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  email           String
  plano           String
  categoria       SubscriptionCategory @default(plataforma)
  status          SubscriptionStatus   @default(trialing)
  periodoInicio   DateTime             @map("periodo_inicio") @db.Timestamptz(6)
  periodoFim      DateTime             @map("periodo_fim") @db.Timestamptz(6)
  cancelarAoFim   Boolean              @default(false) @map("cancelar_ao_fim")
  mpPayerId       String?              @map("mp_payer_id")
  mpPreapprovalId String?              @map("mp_preapproval_id")
  mpPlanId        String?              @map("mp_plan_id")
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, categoria])
  @@index([email])
  @@index([mpPayerId])
  @@index([mpPreapprovalId])
  @@map("subscriptions")
}

model MercadoPagoWebhookEvent {
  id          String             @id
  type        String
  status      WebhookEventStatus @default(processing)
  attempts    Int                @default(1)
  lastError   String?            @map("last_error")
  processedAt DateTime?          @map("processed_at") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@map("mercadopago_webhook_events")
}

model AuditEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?  @map("user_id")
  scope         String
  action        String
  outcome       String
  entityType    String?  @map("entity_type")
  entityId      String?  @map("entity_id")
  requestId     String?  @map("request_id")
  ipHash        String?  @map("ip_hash")
  userAgentHash String?  @map("user_agent_hash")
  emailHash     String?  @map("email_hash")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([scope, action, createdAt])
  @@index([outcome, createdAt])
  @@map("audit_events")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String
  name        String
  description String?
  scope       String           @default("global")
  tenantId    String?          @map("tenant_id")
  module      String?
  system      Boolean          @default(false)
  active      Boolean          @default(true)
  metadata    Json?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  userRoles   UserRole[]
  permissions RolePermission[]

  @@unique([key, tenantId, module])
  @@index([tenantId])
  @@index([module])
  @@index([scope])
  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique
  module      String
  action      String
  scope       String           @default("module")
  description String?
  system      Boolean          @default(true)
  metadata    Json?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@index([module])
  @@index([scope])
  @@map("permissions")
}

model UserRole {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  roleId           String    @map("role_id") @db.Uuid
  tenantId         String?   @map("tenant_id")
  module           String?
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)
  assignedBy       User?     @relation("RbacAssignedRoles", fields: [assignedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  role             Role      @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user             User      @relation("RbacUserRoles", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, roleId, tenantId, module])
  @@index([userId, tenantId])
  @@index([roleId])
  @@index([tenantId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model DataIngestionJob {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String?   @map("tenant_id")
  source            String
  connector         String
  status            String    @default("queued")
  pipelineStage     String    @default("ingestion") @map("pipeline_stage")
  requestedByUserId String?   @map("requested_by_user_id")
  startedAt         DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt        DateTime? @map("finished_at") @db.Timestamptz(6)
  recordsSeen       Int       @default(0) @map("records_seen")
  recordsAccepted   Int       @default(0) @map("records_accepted")
  recordsDuplicated Int       @default(0) @map("records_duplicated")
  recordsFailed     Int       @default(0) @map("records_failed")
  retries           Int       @default(0)
  errorMessage      String?   @map("error_message")
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@index([source, status, createdAt])
  @@index([pipelineStage, status])
  @@map("data_ingestion_jobs")
}

model DataSourceCursor {
  id           String    @id @default(cuid())
  tenantId     String?   @map("tenant_id")
  source       String
  cursorKey    String    @map("cursor_key")
  cursorValue  Json?     @map("cursor_value")
  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([source, tenantId, cursorKey])
  @@index([tenantId])
  @@index([source, lastSyncedAt])
  @@map("data_source_cursors")
}

model DataPipelineEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId      String?  @map("job_id")
  tenantId   String?  @map("tenant_id")
  traceId    String?  @map("trace_id")
  source     String
  stage      String
  level      String   @default("info")
  message    String
  durationMs Int?     @map("duration_ms")
  counters   Json?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([jobId])
  @@index([tenantId])
  @@index([source, stage, createdAt])
  @@index([traceId])
  @@map("data_pipeline_events")
}

model LegalDocument {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String?   @map("tenant_id")
  source         String
  externalId     String?   @map("external_id")
  dedupeKey      String    @unique @map("dedupe_key")
  contentHash    String    @map("content_hash")
  title          String
  documentType   String    @map("document_type")
  bodyText       String?   @map("body_text")
  url            String?
  issuedAt       DateTime? @map("issued_at") @db.Timestamptz(6)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  classification Json?
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@index([source, externalId])
  @@index([documentType, publishedAt])
  @@index([contentHash])
  @@map("legal_documents")
}

model Jurisprudence {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String?   @map("tenant_id")
  source       String
  externalId   String?   @map("external_id")
  dedupeKey    String    @unique @map("dedupe_key")
  contentHash  String    @map("content_hash")
  court        String
  caseNumber   String?   @map("case_number")
  title        String
  summary      String?
  decisionText String?   @map("decision_text")
  decisionDate DateTime? @map("decision_date") @db.Timestamptz(6)
  url          String?
  metadata     Json?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@index([source, externalId])
  @@index([court, decisionDate])
  @@index([contentHash])
  @@map("jurisprudence")
}

model AnnualProcurementPlan {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pncpId        String   @unique @map("pncp_id")
  year          Int
  buyerName     String   @map("buyer_name")
  buyerDocument String   @map("buyer_document")
  uf            String?
  municipality  String?
  totalItems    Int      @default(0) @map("total_items")
  totalValue    Decimal? @map("total_value") @db.Decimal(18, 2)
  rawPayload    Json?    @map("raw_payload")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([year, uf])
  @@index([buyerDocument])
  @@map("annual_procurement_plans")
}

model ProcurementNotice {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String?                  @map("tenant_id")
  source            String
  externalId        String?                  @map("external_id")
  dedupeKey         String                   @unique @map("dedupe_key")
  contentHash       String                   @map("content_hash")
  noticeNumber      String?                  @map("notice_number")
  modality          String?
  modalityEnum      ProcurementModality?     @map("modality_enum")
  judgmentCriterion JudgmentCriterion?       @map("judgment_criterion")
  executionRegime   ExecutionRegime?         @map("execution_regime")
  exclusiveMeEpp    Boolean                  @default(false) @map("exclusive_me_epp")
  buyerName         String?                  @map("buyer_name")
  buyerDocument     String?                  @map("buyer_document")
  object            String
  uf                String?
  municipality      String?
  estimatedValue    Decimal?                 @map("estimated_value") @db.Decimal(18, 2)
  status            String?
  url               String?
  publishedAt       DateTime?                @map("published_at") @db.Timestamptz(6)
  openingAt         DateTime?                @map("opening_at") @db.Timestamptz(6)
  closingAt         DateTime?                @map("closing_at") @db.Timestamptz(6)
  rawPayload        Json?                    @map("raw_payload")
  classification    Json?
  metadata          Json?
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  biddingHistory    BiddingHistory[]
  legalAnalyses     LegalAnalysis[]
  lots              ProcurementLot[]
  items             ProcurementItem[]
  attachments       ProcurementAttachment[]
  requirements      ProcurementRequirement[]
  proposals         Proposal[]
  events            ProcurementEvent[]
  biddingPipelines  BiddingPipeline[]

  monitoredByCompanies CompanyMonitoredNotice[]
  deadlines            Deadline[]

  @@index([tenantId])
  @@index([source, externalId])
  @@index([uf, publishedAt])
  @@index([modality])
  @@index([contentHash])
  @@map("procurement_notices")
}

model BiddingPipeline {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  noticeId  String   @map("notice_id") @db.Uuid
  stage     String   @default("OPORTUNIDADE")
  position  Int      @default(0)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  notice ProcurementNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@index([userId, stage])
  @@map("bidding_pipelines")
}

model ProcurementLot {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String?  @map("tenant_id")
  procurementNoticeId String   @map("procurement_notice_id") @db.Uuid
  lotNumber           String   @map("lot_number")
  title               String
  description         String?
  estimatedValue      Decimal? @map("estimated_value") @db.Decimal(18, 2)
  status              String?
  metadata            Json?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  procurementNotice ProcurementNotice @relation(fields: [procurementNoticeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items             ProcurementItem[]

  @@unique([procurementNoticeId, lotNumber])
  @@index([tenantId])
  @@index([procurementNoticeId])
  @@map("procurement_lots")
}

model ProcurementItem {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String?  @map("tenant_id")
  procurementNoticeId     String   @map("procurement_notice_id") @db.Uuid
  lotId                   String?  @map("lot_id") @db.Uuid
  itemNumber              String   @map("item_number")
  description             String
  quantity                Decimal? @db.Decimal(18, 4)
  unit                    String?
  estimatedUnitValue      Decimal? @map("estimated_unit_value") @db.Decimal(18, 4)
  estimatedTotalValue     Decimal? @map("estimated_total_value") @db.Decimal(18, 2)
  brandReference          Boolean  @default(false) @map("brand_reference")
  catalogoCodigo          String?  @map("catalogo_codigo")
  catalogoPrecoReferencia Decimal? @map("catalogo_preco_referencia") @db.Decimal(18, 4)
  metadata                Json?
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  procurementNotice ProcurementNotice @relation(fields: [procurementNoticeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lot               ProcurementLot?   @relation(fields: [lotId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([procurementNoticeId, itemNumber])
  @@index([tenantId])
  @@index([procurementNoticeId])
  @@index([lotId])
  @@index([brandReference])
  @@map("procurement_items")
}

model ProcurementAttachment {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String?  @map("tenant_id")
  procurementNoticeId String   @map("procurement_notice_id") @db.Uuid
  source              String
  externalId          String?  @map("external_id")
  attachmentType      String   @map("attachment_type")
  fileName            String   @map("file_name")
  fileUrl             String   @map("file_url")
  mimeType            String?  @map("mime_type")
  contentHash         String?  @map("content_hash")
  extractedText       String?  @map("extracted_text") @db.Text
  metadata            Json?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

