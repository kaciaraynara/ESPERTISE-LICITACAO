# =============================================================================
# EXPERTISE LICITATÓRIA — DATA ENGINE (VARIÁVEIS DE AMBIENTE)
# =============================================================================

# String de Conexão com o PostgreSQL Neon (ou banco de produção)
# Caso não seja definida aqui, o script herdará do backend/.env automaticamente
DATABASE_URL="postgresql://neondb_owner:SENHA@ep-cold-lake-avgtbfr7.c-11.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Endpoint da API Oficial de Consulta do PNCP
PNCP_BASE_URL="https://pncp.gov.br/api/consulta/v1"

# Quantidade de dias retroativos para sincronização diária contínua (ex: 3 dias)
SYNC_DAYS=3

# Modalidades de Licitação para Captura (Lei 14.133/2021)
# 8 = Pregão Eletrônico | 14 = Dispensa Eletrônica | 6 = Concorrência | 12 = Credenciamento
SYNC_MODALIDADES=8,14,6

# Limite de páginas por modalidade a cada execução (20 páginas x 20 itens = 400 editais por modalidade)
SYNC_MAX_PAGES=20

# Tamanho da página (mínimo exigido pela API do PNCP é 10, padrão: 20)
SYNC_PAGE_SIZE=20

# Filtro de UF opcional (ex: SP ou deixar em branco para Brasil inteiro)
# SYNC_UF=
